[Unit]
Description=Observe KR v12 natural paper strategy fills for the 2026-10-02 session
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/kinvest_trade
Environment=PYTHONPATH=%h/kinvest_trade/src
ExecStart=%h/kinvest_trade/.venv/bin/python -m kinvest_trade.execution_acceptance --session-date 2026-10-02 --notify
TimeoutStartSec=45s
UMask=0077
Restart=no
